export interface FaqRule {
  id: string;
  keywords: string[];
  mode: 'exact' | 'includes' | 'startsWith';
  reply: string;
}

export interface BotConfig {
  brand: {
    name: string;
    pointsName: string;
    greeting: string;
  };
  welcome: {
    enabled: boolean;
    text: string; // 鍗犱綅绗? {name} {chat} {id}
    deleteSystemMessages: boolean;
  };
  faq: FaqRule[];
  checkin: {
    enabled: boolean;
    rewardPoints: number;
    // 杩炵画绛惧埌閲岀▼纰戦澶栧鍔憋紙杈炬垚瀵瑰簲澶╂暟褰撳ぉ涓€娆℃€у彂鏀撅級
    streakBonuses: { days: number; points: number }[];
  };
  invite: {
    invitedReward: number; // 琚個璇蜂汉鑾峰緱
    inviterReward: number; // 閭€璇蜂汉鑾峰緱
  };
  top: {
    limit: number; // 鎺掕姒滃睍绀烘潯鏁?
  };
  ai: {
    enabled: boolean;
    model: string;
    maxTokens: number;
    promptSystem: string;
    rateLimitPerMin: number;
  };
  tools: {
    enabled: string[]; // 鍙敤宸ュ叿 id 鍒楄〃
  };
  limits: {
    maxTextLen: number; // FAQ/AI 鍙備笌鐨勬渶闀挎枃鏈?
  };
  adblock: {
    enabled: boolean;
    keywords: string[]; // 骞垮憡鍏抽敭璇嶅垪琛?
    action: 'delete' | 'delete_and_ban'; // 鍛戒腑鍚庣殑澶勭悊鏂瑰紡
    adminBypass: boolean; // 绠＄悊鍛樻槸鍚﹁眮鍏嶆娴?
  };
}

